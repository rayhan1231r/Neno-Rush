rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().username is string
        && incoming().username.size() >= 2
        && incoming().username.size() <= 30;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'avatarSeed', 'lastSyncedAt']);
      allow delete: if false;

      // Subcollection: Game Data (Inventory, Stats, Missions)
      match /gameData/{docId} {
        allow read: if isOwner(userId);
        
        // Inventory document: equipped character/board & unlocked collections
        allow create, update: if isOwner(userId)
          && isValidId(docId)
          && (
            docId == 'inventory'
            || docId == 'stats'
            || docId == 'missions'
          );
        allow delete: if false;
      }
    }

    // 2. Global Leaderboards
    // Readable by all players; writes are strictly gated to prevent client score tampering
    match /leaderboard/{period}/scores/{scoreId} {
      allow read: if true;
      allow write: if false; // Scores must be validated and written via trusted server anti-cheat
    }

    // 3. Purchase Transaction Audit Ledger
    // Only the purchaser can read their own verified receipts; clients cannot write receipts
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && isValidId(transactionId) && resource.data.userId == request.auth.uid;
      allow write: if false; // Only trusted backend can record verified purchase receipts
    }
  }
}
